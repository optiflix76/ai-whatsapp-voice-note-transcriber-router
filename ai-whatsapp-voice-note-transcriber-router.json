      "id": "0ff3df8f-68ed-4786-9732-6b0688a956a2",
      "name": "clickup alt",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        6128,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────────────────\n// SPLIT REMAINING ACTION ITEMS\n// The first task was created in ClickUp by the previous node.\n// This node emits one item per remaining action item so\n// each gets its own ClickUp task. If only one task exists,\n// this node returns nothing.\n// ─────────────────────────────────────────────────────────\n\nconst items      = $json.actionItems || [];\nconst remaining  = items.slice(1);   // skip index 0 — already created\n\nif (remaining.length === 0) return [];\n\nreturn remaining.map(task => ({\n  json: {\n    ...$json,\n    currentTask: task\n  }\n}));"
      },
      "id": "b9990fcb-cd6e-42c6-9c15-2f2f47645943",
      "name": "🔁 Split Remaining Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6656,
