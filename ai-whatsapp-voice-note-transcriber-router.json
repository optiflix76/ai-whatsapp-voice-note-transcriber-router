      "id": "6e7fd5af-ab2c-465f-afa7-36c5b2dd3178",
      "name": "🎙️ Whisper Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        3728,
        640
      ]
    },
    {
      "parameters": {
        "content": "**Alt transcription engines:**\n- AssemblyAI — better speaker diarisation\n- Azure Speech — data residency in UAE North\n- Deepgram Nova-2 — fastest, cheapest",
        "height": 190,
        "width": 220,
        "color": 6
      },
      "id": "4aa2fbdb-97fa-4105-a6bd-a4893e20e516",
      "name": "whisper alt",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        3680,
        800
      ]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────────────────\n// PREPARE TRANSCRIPT\n// Whisper returns verbose_json which includes the full text\n// plus segment-level timestamps. We extract what we need\n// and pass it forward cleanly.\n// ─────────────────────────────────────────────────────────\n\nconst whisperResult = $json;\nconst upstream      = $('🔍 Parse Webhook Payload').first().json;\n\nconst transcriptText  = whisperResult.text?.trim() || '';\nconst detectedLang    = whisperResult.language      || 'unknown';\nconst durationSeconds = whisperResult.duration      || 0;\n\nif (!transcriptText) {\n  throw new Error('Whisper returned an empty transcript. The audio may be silent or corrupted.');\n}\n\n// Rough word count (useful for analytics)\nconst wordCount = transcriptText.split(/\\s+/).filter(Boolean).length;\n\nreturn [{\n  json: {\n    // Ingestion metadata\n    senderPhone:    upstream.senderPhone,\n    senderName:     upstream.senderName,\n    businessPhone:  upstream.businessPhone,\n    receivedAt:     upstream.receivedAt,\n    audioId:        upstream.audioId,\n\n    // Transcript\n    transcript:     transcriptText,\n    language:       detectedLang,\n    durationSec:    Math.round(durationSeconds),\n    wordCount\n  }\n}];"
      },
      "id": "46cef5cf-8626-4206-8048-402bcb319e68",
      "name": "📝 Prepare Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3936,
        640
      ]
    },
    {
      "parameters": {
        "resource": "chat"
      },
      "id": "53b0f927-0cfa-4c81-86a9-45a711042db2",
      "name": "🤖 LLM: Analyse Intent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [
        4336,
        656
      ]
    },
    {
      "parameters": {
        "content": "**Alt:** Claude is preferred for Arabic-heavy transcripts. Swap model node — the prompt and schema work unchanged.",
        "height": 138,
        "width": 220,
        "color": 5
      },
      "id": "ef59445d-d4c1-4b76-a3eb-080f2396cd78",
      "name": "llm alt",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        4288,
        784
      ]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────────────────\n// PARSE & MERGE LLM OUTPUT\n// Strips markdown fences, parses JSON, merges with\n// transcript metadata, and produces the single object\n// that all downstream routing nodes consume.\n// ─────────────────────────────────────────────────────────\n\nconst llmRaw   = $json.message?.content\n               || $json.choices?.[0]?.message?.content\n               || '';\n\nconst upstream = $('📝 Prepare Transcript').first().json;\n\nconst cleaned = llmRaw\n  .replace(/```json\\s*/gi, '')\n  .replace(/```\\s*/g, '')\n  .trim();\n\nlet analysis;\ntry {\n  analysis = JSON.parse(cleaned);\n} catch (err) {\n  throw new Error(`LLM returned invalid JSON. Raw: ${llmRaw.slice(0, 200)}`);\n}\n\n// ── Build Slack digest (used by multiple output nodes) ────\nconst taskLines = (analysis.action_items || [])\n  .map((t, i) => `  ${i + 1}. ${t.task}${t.assignee_hint ? ' → ' + t.assignee_hint : ''}${t.due_hint ? ' (by ' + t.due_hint + ')' : ''}`)\n  .join('\\n');\n\nconst decisionLines = (analysis.decisions || [])\n  .map(d => `  • ${d}`)\n  .join('\\n');\n\nconst sentimentEmoji = {\n  positive: '🟢', neutral: '🔵', urgent: '🟠', negative: '🔴'\n}[analysis.sentiment] || '⚪';\n\nconst slackDigest =\n  `${sentimentEmoji} *Voice Note — ${analysis.intent?.replace(/_/g, ' ').toUpperCase()}*\\n` +\n  `*From:* ${upstream.senderName} (${upstream.senderPhone})\\n` +\n  `*Received:* ${upstream.receivedAt}\\n` +\n  `*Duration:* ${upstream.durationSec}s  |  *Language:* ${analysis.language}\\n\\n` +\n  `*Summary:*\\n${analysis.summary}\\n` +\n  (taskLines    ? `\\n*Action Items:*\\n${taskLines}\\n`    : '') +\n  (decisionLines ? `\\n*Decisions:*\\n${decisionLines}\\n` : '') +\n  (analysis.requires_human_review ? `\\n⚠️ *Needs Review:* ${analysis.review_reason}` : '');\n\nreturn [{\n  json: {\n    // Pass-through\n    ...upstream,\n    // LLM analysis\n    intent:              analysis.intent,\n    summary:             analysis.summary,\n    actionItems:         analysis.action_items   || [],\n    decisions:           analysis.decisions      || [],\n    sentiment:           analysis.sentiment,\n    language:            analysis.language,\n    keyEntities:         analysis.key_entities   || {},\n    requiresHumanReview: analysis.requires_human_review || false,\n    reviewReason:        analysis.review_reason  || null,\n    // Pre-formatted outputs\n    slackDigest\n  }\n}];"
      },
      "id": "019dd788-810a-41f2-aecd-fb1ec8a4060b",
      "name": "🔧 Parse LLM Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4576,
        656
      ]
    },
