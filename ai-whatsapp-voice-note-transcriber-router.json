    {
      "parameters": {
        "content": "Meta media URLs expire after ~5 min. These two steps (resolve URL → download) must run in sequence immediately after the webhook fires.",
        "height": 164,
        "width": 220,
        "color": 6
      },
      "id": "ee0892f7-a2bb-4cd2-8be8-01d67656567b",
      "name": "download note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        3344,
